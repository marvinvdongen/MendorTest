{
  "expo": {
    "name": "ContractorERP",
    "slug": "contractor-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1B4965"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.contractor.erp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4965"
      },
      "package": "com.contractor.erp"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "contractor-erp",
    "plugins": ["expo-router"]
  }
}
